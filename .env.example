# ============================================================
# HR 管理系统 · 统一 .env（PRD §7D 合并版）
# ============================================================
# 单文件承载三环境配置，通过 APP_ENV=dev|test|prod 切换（默认 dev）
# v2.5 起存储为 SQLite 同机三文件：data/hr_db_{env}.db（环境物理隔离）
# 旧的 .env.test / .env.prod 仍兼容（若存在），但已无需单独维护
# 优先级：shell 显式 DATABASE_URL > DATABASE_URL_{env} > 默认拼接
# ============================================================

# 当前环境（dev/test/prod，大小写不敏感；也可通过 shell: APP_ENV=prod ...）
APP_ENV=dev

# 三环境库文件（按 APP_ENV 自动选择 DATABASE_URL_{env}；相对路径基于项目根）
DATABASE_URL_dev=sqlite:///./data/hr_db_dev.db
DATABASE_URL_test=sqlite:///./data/hr_db_test.db
DATABASE_URL_prod=sqlite:///./data/hr_db_prod.db

# 若需强制指定库（不走分流），可直接设置（优先级更高）：
# DATABASE_URL=sqlite:///./data/hr_db_dev.db

# 文件名强制 hr_db_{env}.db，与 APP_ENV 不一致时拒绝启动（PRD §7D.2）
# SQLite 每连接自动注入 PRAGMA：foreign_keys=ON / WAL / busy_timeout=30000（app/db.py）

# ============================================================
# 认证与安全（PRD §7B / §7C / §7B.2）
# ============================================================
# JWT 密钥（生产必须覆盖为强随机串，至少 32 字符）：
# JWT_SECRET_KEY=change-me-in-prod-please-use-strong-random
# Token 有效期（分钟，默认 720 = 12h）：
# JWT_EXPIRE_MINUTES=720
# 默认管理员（首次启动自动创建）：
# DEFAULT_ADMIN_USER=admin
# DEFAULT_ADMIN_PASSWORD=admin123

# 速率限制（PRD §7B.2，slowapi）：
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_PUBLIC=60/minute
# 多实例部署时需共享限流计数，请设为 Redis（单实例默认 memory://）：
# LIMITER_STORAGE_URI=redis://localhost:6379
# 需安装 redis 依赖：pip install redis

# 备份提示：SQLite 直接复制 .db 文件即可（建议先 wal_checkpoint 或连同 -wal/-shm 三件套一起复制）：
#   sqlite3 data/hr_db_prod.db "PRAGMA wal_checkpoint(TRUNCATE);" && cp data/hr_db_prod.db backup/
