# ============================================================
# HR 管理系统 · 三环境 DB 隔离配置（PRD §7D）
# ============================================================
# 约定：
#   - APP_ENV ∈ {dev, test, prod}（大小写不敏感，默认 dev）
#   - 库名强制 hr_db_{env}，DATABASE_URL 库名与 APP_ENV 不一致时拒绝启动
#   - 文件全部 gitignored（见 .gitignore）
#   - 加载顺序：shell 显式 > .env.{env} > .env
#
# 启动时（app/db.py）按 APP_ENV 自动加载 .env.test / .env.prod / .env。
# 你只需确保下面三种文件存在并填好密码即可。
# ============================================================

# ---- dev：本地开发默认 ----
# 文件：.env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_db_dev
# APP_ENV=dev   # 缺省即 dev，无需显式

# ---- test：自动化测试 / 临时验证 ----
# 文件：.env.test
# APP_ENV=test 时自动加载
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_db_test

# ---- prod：生产环境 ----
# 文件：.env.prod
# APP_ENV=prod 时自动加载
# 注意：prod 下 --reset / drop_all 一律被拦截（FATAL）
# 密码等敏感信息强烈建议通过 shell 变量注入（避免 .env.prod 入版本管理）：
#   DATABASE_URL=postgresql://postgres:${POSTGRES_PASSKEY}@localhost:5432/hr_db_prod
#   export POSTGRES_PASSKEY='your-real-password'   # 启动前 export
# 也可直接硬编码（仅在不纳入版本管理的本地 .env.prod 中）：
#   DATABASE_URL=postgresql://hr_user:STRONG_PASSWORD@prod-db.internal:5432/hr_db_prod

# ---- 通用可选覆盖 ----
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# 当 DATABASE_URL 显式未设时，按 DB_* + hr_db_{APP_ENV} 拼默认连接

# ============================================================
# 认证与安全（PRD §7B / §7C）
# ============================================================
# JWT 密钥（生产必须覆盖为强随机串，至少 32 字符）：
# JWT_SECRET_KEY=change-me-in-prod-please-use-strong-random
# Token 有效期（分钟，默认 720 = 12h）：
# JWT_EXPIRE_MINUTES=720
# 默认管理员（首次启动自动创建）：
# DEFAULT_ADMIN_USER=admin
# DEFAULT_ADMIN_PASSWORD=admin123